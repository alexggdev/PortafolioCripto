{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=CriptoPortfolio;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "CriptoPortfolio",
    "Audience": "CriptoPortfolio.Web",
    "SigningKey": "",
    "ExpirationMinutes": 15,
    "RefreshTokenDays": 14
  },
  "CoinGecko": {
    "BaseUrl": "https://api.coingecko.com/api/v3/",
    "ApiKey": "",
    "ApiKeyHeader": "x-cg-demo-api-key",
    "PageSize": 250,
    "TimeoutSeconds": 30
  },
  "CatalogSync": {
    "Enabled": true,
    "TopCount": 500,
    "IntervalMinutes": 15,
    "LeaseMinutes": 10,
    "StartupDelaySeconds": 5
  },
  "Binance": {
    "BaseUrl": "https://data-api.binance.vision/api/v3/",
    "TimeoutSeconds": 10
  },
  "LivePrices": {
    "Enabled": true,
    "IntervalSeconds": 5,
    "MappingMinutes": 10,
    "MappingLeaseMinutes": 5,
    "StartupDelaySeconds": 20,
    "MaxPriceDeviation": 0.25,
    "StaleSeconds": 60
  },
  "HistorySync": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "LeaseMinutes": 30,
    "StartupDelaySeconds": 45,
    "BinanceInitialDays": 1825,
    "CoinGeckoInitialDays": 365,
    "BinanceDelayMs": 250,
    "CoinGeckoDelayMs": 2500,
    "SnapshotWindowMinutes": 30,
    "MaxConsecutiveFailures": 5,
    "EmptyRetryHours": 6,
    "FailureRetryMinutes": 60
  },
  "ExchangeRate": {
    "BaseUrl": "https://open.er-api.com/v6/",
    "TimeoutSeconds": 10
  },
  "FxRates": {
    "Enabled": true,
    "RefreshMinutes": 360,
    "RetryMinutes": 10,
    "StartupDelaySeconds": 3,
    "MaxChangeFraction": 0.5,
    "IgnoreCheckAfterDays": 7
  },
  "Portfolio": {
    "CostBasisMethod": "Fifo",
    "MaxTransactionsPerUser": 20000,
    "DefaultPortfolioName": "Mi portafolio"
  },
  "Cors": {
    "Origins": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cripto-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}